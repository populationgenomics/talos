# SVAFotate, used to annotate Structural Variants with gnomAD population frequencies.
#
# This is built as a standalone image rather than being added to the main Talos container.
# SVAFotate pins cyvcf2==0.30.4, pandas==1.2.3 and numpy==1.22.3, which conflict with Talos's
# own requirements (cyvcf2>=0.30.18, and the numpy/pandas versions required by hail~=0.2.137).
#
# Python 3.9 is deliberate - pandas 1.2.3 predates CPython 3.10 support and has no wheels for it.
#
# build with "docker build -f SVAFotate_Dockerfile -t svafotate:0.1.0 ."

FROM python:3.11-slim-bullseye

ENV DEBIAN_FRONTEND=noninteractive

# SVAFotate is not published to PyPI and the repository carries no releases or tags,
# so it is pinned to an explicit commit. Last verified 2026-07-30.
ARG SVAFOTATE_COMMIT=30b5004a0f4d26959c6b9a82f165651585293626

RUN apt-get update && apt-get install --no-install-recommends -y \
        ca-certificates \
        gcc \
        git \
        libbz2-dev \
        libcurl4-openssl-dev \
        liblzma-dev \
        libssl-dev \
        make \
        zlib1g-dev && \
    rm -rf /var/lib/apt/lists/* && \
    rm -rf /var/cache/apt/*

# versions taken from the project's own requirements.txt, minus the conda-only entries
# (htslib, zlib and python are provided by the base image and the apt layer above)
RUN pip install --upgrade pip setuptools && \
    pip install --no-cache-dir \
        numpy \
        pandas \
        pyranges \
        ncls \
        cyvcf2 && \
    pip install --no-cache-dir "git+https://github.com/fakedrtom/SVAFotate.git@${SVAFOTATE_COMMIT}"

RUN svafotate --version
